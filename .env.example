# PostgreSQL connection string used by Prisma (src/lib/db.js and prisma.config.ts)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Managed providers (Neon, Supabase, etc.) usually require ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedido_facil?schema=public"

# Secret used to sign/verify the session JWT (src/lib/auth.js).
# Use a long random value in production, e.g.: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# Chave para criptografia AES-256-GCM de credenciais salvas no banco (ex.: mp_access_token).
# Se omitida, deriva da JWT_SECRET. Recomendado definir uma chave dedicada em produção.
ENCRYPTION_KEY="change-me-to-another-long-random-secret"

# WhatsApp via Evolution API (src/lib/whatsapp.js).
# Cada loja conecta o próprio WhatsApp pelo QR Code no painel (logo após criar a loja ou na Visão Geral).
# Se EVOLUTION_API_URL ou EVOLUTION_API_KEY ficarem vazias, o envio é desativado e os pedidos continuam funcionando.
# EVOLUTION_API_KEY também é usada pelo docker-compose como AUTHENTICATION_API_KEY da Evolution API.
# EVOLUTION_INSTANCE é opcional e serve apenas como fallback caso a loja ainda não tenha conectado um número próprio.
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="change-me-evolution-api-key"
EVOLUTION_INSTANCE="pedido-facil"

# Mercado Pago (opcional no .env — cada loja também pode conectar o próprio Access Token em /dashboard).
# APP_URL é usada para back_urls e webhook do Mercado Pago em produção (ex.: https://seusite.com.br).
# MERCADOPAGO_WEBHOOK_SECRET valida a assinatura x-signature enviada nos webhooks.
# MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
# MERCADOPAGO_WEBHOOK_SECRET="..."
# APP_URL="https://seusite.com.br"
