# PostgreSQL connection string used by Prisma (src/lib/db.js and prisma.config.ts)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Managed providers (Neon, Supabase, etc.) usually require ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedido_facil?schema=public"

# Secret used to sign/verify the session JWT (src/lib/auth.js).
# Use a long random value in production, e.g.: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"
